{
  "name": "aram-emballage-android",
  "version": "1.0.0",
  "private": true,
  "description": "Phone-friendly Android packaging project for ARAM emballage",
  "scripts": {
    "build": "node scripts/prepare.mjs && esbuild src/zxing-entry.js --bundle --platform=browser --format=iife --target=es2020 --outfile=www/zxing-bundle.js"
  },
  "dependencies": {
    "@capacitor/android": "7.4.3",
    "@capacitor/core": "7.4.3",
    "@zxing/browser": "0.1.5"
  },
  "devDependencies": {
    "@capacitor/cli": "7.4.3",
    "esbuild": "0.25.5"
  }
}
